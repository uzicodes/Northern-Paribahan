generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// --- ENUMS for strict Data Integrity ---
enum Role {
  USER
  ADMIN
}

enum BusType {
  AC
  NON_AC
  SLEEPER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// --- MODELS ---

model User {
  id          String    @id @default(uuid()) @db.Uuid // Matches Supabase Auth UUID
  name        String?
  email       String    @unique
  password    String?
  phoneNumber String?   @map("phone_number")
  role        Role      @default(USER) 
  bookings    Booking[]
  createdAt   DateTime  @default(now())

  @@map("users") // PostgreSQL standard is lowercase plural
}

model Bus {
  id                 String     @id @default(cuid())
  name               String     // e.g., "Volvo B11R"
  registrationNumber String     @unique @map("registration_number")
  type               BusType
  capacity           Int        // e.g., 40
  schedules          Schedule[]
  createdAt          DateTime   @default(now())

  @@map("buses")
}

model Route {
  id              String     @id @default(cuid())
  origin          String     // e.g., "Dhaka"
  destination     String     // e.g., "Chittagong"
  estimatedHours  Float?     @map("estimated_hours")
  schedules       Schedule[]
  createdAt       DateTime   @default(now())

  @@index([origin, destination])
  @@map("routes")
}

model Schedule {
  id                 String    @id @default(cuid())
  departureTime      DateTime  @map("departure_time")
  arrivalTime        DateTime  @map("arrival_time")
  fare               Float     // Price belongs to the schedule, not the bus
  
  // Snapshot fields for fast reads and Supabase Studio inspection
  origin             String
  destination        String
  busName            String    @map("bus_name")
  registrationNumber String    @map("registration_number")

  // Relationships
  busId              String    @map("bus_id")
  bus                Bus       @relation(fields: [busId], references: [id])
  routeId            String    @map("route_id")
  route              Route     @relation(fields: [routeId], references: [id])
  
  bookings           Booking[]
  tickets            Ticket[]  // To quickly check which seats are taken for this specific trip

  @@index([departureTime])
  @@index([origin, destination])
  @@index([departureTime, origin, destination])
  @@map("schedules")
}

model Booking {
  id            String        @id @default(cuid())
  userId        String        @db.Uuid @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  scheduleId    String        @map("schedule_id")
  schedule      Schedule      @relation(fields: [scheduleId], references: [id])
  
  totalFare     Float         @map("total_fare")
  status        BookingStatus @default(PENDING)
  transactionId String?       @map("transaction_id") // Ready for payment gateway integration
  
  tickets       Ticket[]
  createdAt     DateTime      @default(now())

  @@map("bookings")
}

model Ticket {
  id         String   @id @default(cuid())
  seatNumber String   @map("seat_number") // e.g., "A1"
  
  bookingId  String   @map("booking_id")
  booking    Booking  @relation(fields: [bookingId], references: [id])
  
  scheduleId String   @map("schedule_id")
  schedule   Schedule @relation(fields: [scheduleId], references: [id])

  // CRUCIAL: A specific seat can only be booked ONCE per schedule
  @@unique([scheduleId, seatNumber]) 
  @@index([scheduleId])
  @@map("tickets")
}