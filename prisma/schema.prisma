generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Role {
  USER
  ADMIN
}

enum BusTier {
  PREMIUM
  BUSINESS
  ECONOMY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// --- MODELS ---

model User {
  id          String    @id @default(uuid()) @db.Uuid
  name        String?
  email       String    @unique
  password    String?
  phoneNumber String?   @map("phone_number")
  role        Role      @default(USER)
  bookings    Booking[]
  createdAt   DateTime  @default(now())

  @@map("users")
}

model Depot {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  city      String
  buses     Bus[]
  createdAt DateTime @default(now())

  @@map("depots")
}

model Bus {
  id                 String     @id @default(cuid())
  modelName          String     @map("model_name")
  registrationNumber String     @unique @map("registration_number")
  tier               BusTier
  capacity           Int        @default(40)
  
  depotId            String     @map("depot_id")
  depot              Depot      @relation(fields: [depotId], references: [id], onDelete: Cascade)
  
  schedules          Schedule[]
  createdAt          DateTime   @default(now())

  @@index([depotId])
  @@index([tier])
  @@map("buses")
}

model Route {
  id             String     @id @default(cuid())
  routeId        String     @unique @map("route_id") 
  origin         String
  destination    String
  estimatedHours Float?     @map("estimated_hours")
  
  schedules      Schedule[]
  fares          Fare[]

  createdAt      DateTime   @default(now())

  @@index([origin, destination])
  @@map("routes")
}

model Fare {
  id        String   @id @default(cuid())
  price     Float
  tier      BusTier
  
  routeId   String   @map("route_id")
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, tier])
  @@index([routeId])
  @@map("fares")
}

model Schedule {
  id                 String    @id @default(cuid())
  departureTime      DateTime  @map("departure_time")
  arrivalTime        DateTime  @map("arrival_time")
  
  origin             String
  destination        String
  busName            String    @map("bus_name")
  registrationNumber String    @map("registration_number")

  busId              String    @map("bus_id")
  bus                Bus       @relation(fields: [busId], references: [id])
  routeId            String    @map("route_id")
  route              Route     @relation(fields: [routeId], references: [id])
  
  bookings           Booking[]
  tickets            Ticket[]

  @@index([departureTime])
  @@index([origin, destination])
  @@index([departureTime, origin, destination])
  @@map("schedules")
}

model Booking {
  id            String        @id @default(cuid())
  userId        String        @db.Uuid @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  scheduleId    String        @map("schedule_id")
  schedule      Schedule      @relation(fields: [scheduleId], references: [id])
  
  totalFare     Float         @map("total_fare")
  status        BookingStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  
  tickets       Ticket[]
  createdAt     DateTime      @default(now())

  @@map("bookings")
}

model Ticket {
  id         String   @id @default(cuid())
  seatNumber String   @map("seat_number")
  
  bookingId  String   @map("booking_id")
  booking    Booking  @relation(fields: [bookingId], references: [id])
  
  scheduleId String   @map("schedule_id")
  schedule   Schedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, seatNumber])
  @@index([scheduleId])
  @@map("tickets")
}